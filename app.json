{
  "expo": {
    "name": "Nobi Card Scanner",
    "slug": "nobi-card-scanner",
    "version": "1.0.27",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "life.nobi.cardscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of business cards and badges",
        "NSMicrophoneUsageDescription": "Record voice notes for follow-up tasks"
      }
    },
    "android": {
      "package": "life.nobi.cardscanner",
      "versionCode": 18
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of business cards"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Record voice notes"
        }
      ]
    ],
    "owner": "bertdehaes",
    "extra": {
      "eas": {
        "projectId": "ddf19813-8410-4408-8d11-d92930d88fa1"
      }
    }
  }
}