{
  "expo": {
    "name": "Nobi Card Scanner",
    "slug": "nobi-card-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "life.nobi.cardscanner",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of business cards and badges",
        "NSMicrophoneUsageDescription": "Record voice notes for follow-up tasks"
      }
    },
    "android": {
      "package": "life.nobi.cardscanner",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      ["expo-image-picker", { "cameraPermission": "Take photos of business cards" }],
      ["expo-av", { "microphonePermission": "Record voice notes" }]
    ]
  }
}
